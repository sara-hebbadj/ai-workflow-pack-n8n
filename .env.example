# Names only. The real values live in "Portfolio Projects/.env" (two folders up), never in this repo.
# n8n does not read this file: in n8n, add the key once as an OpenAI-type credential named
# "OpenRouter (OpenAI-compatible)" (see docs/n8n_setup.md).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_MAIN=
MODEL_CHEAP=
MODEL_JUDGE=
MAX_COST_PER_RUN_USD=3
